# 统一换行符为 LF，避免跨平台 diff 噪声
* text=auto eol=lf

# 显式声明文本文件类型
*.md    text
*.json  text
*.js    text
*.mjs   text
*.cjs   text
*.py    text
*.sh    text
*.yml   text
*.yaml  text
*.txt   text

# 二进制文件不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text
*.zip   binary
*.woff  binary
*.woff2 binary

# 语言统计：文档不计入代码占比
*.md    linguist-documentation
README.md linguist-documentation
LICENSE linguist-documentation
